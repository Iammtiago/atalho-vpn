# Copia este archivo como terraform.tfvars y llénalo.

# Tu IP pública + /32. Sácala con: curl.exe https://checkip.amazonaws.com
ssh_cidr = "0.0.0.0/32"

# El tipo que tu cuenta marque como free tier en São Paulo (paso 1.4): t3.micro, t2.micro o t4g.micro
instance_type = "t3.micro"

# Correo para la alerta de gasto (recomendado)
email_alertas = ""

# Opcionales (valores por defecto)
# name                = "atalho-vpn"
# wg_port             = 51820
# ssh_public_key_path = "~/.ssh/id_ed25519.pub"
# ssh_desde_consola   = true
